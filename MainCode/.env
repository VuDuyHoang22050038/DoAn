# Sao chép file này thành ".env" rồi điền giá trị thật, KHÔNG commit file .env lên git.

PORT=5000
NODE_ENV=production

# MQTT Broker (HiveMQ Cloud hoặc broker riêng)
MQTT_SERVER=mqtts://...       # thay URL của MQTT vào
MQTT_USER=...                 # thay tài khoản của MQTT
MQTT_PASS=...                 # thay tài khoản của MQTT

# Tài khoản trang quản trị Admin (http://server:5000/)
ADMIN_USER=admin
ADMIN_PASS=admin123
